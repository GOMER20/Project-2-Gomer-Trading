# ---------------------------------------------------------------------------
# Gomer Trading - configuration
# `npm run dev` copies this file to .env on first run and generates JWT_SECRET.
# ---------------------------------------------------------------------------

NODE_ENV=development
API_PORT=4000
LOG_LEVEL=info

# --- Data stores -----------------------------------------------------------
# `npm run dev` starts project-local Postgres and Redis on these ports when
# nothing is already listening there. With Docker: `docker compose up -d`.
DATABASE_URL=postgresql://trader:trader@localhost:5432/trading
REDIS_URL=redis://localhost:6379

# --- Auth ------------------------------------------------------------------
# At least 32 characters. Generate one with: openssl rand -hex 48
JWT_SECRET=
JWT_EXPIRES_IN_HOURS=12
# Comma-separated list of browser origins allowed to call the API and WebSocket.
CORS_ORIGIN=http://localhost:3000

# --- Market data -----------------------------------------------------------
# auto      = Alpaca when both keys below are set, otherwise the built-in simulator
# alpaca    = live quotes from Alpaca (keys required)
# simulated = the built-in practice market, no account needed (NOT real prices)
MARKET_DATA_PROVIDER=auto
# Create free keys at https://app.alpaca.markets (Paper Trading > API Keys).
ALPACA_API_KEY=
ALPACA_API_SECRET=
# iex = free real-time feed (max 30 symbols), sip = paid full-market feed
ALPACA_FEED=iex

# The built-in practice market's hours. exchange = it trades only while the US stock market is open
# (9:30 am to 4:00 pm New York time on trading days) and stands still otherwise, which is what the
# app does. always = it never closes: use this while developing, so the test suites
# (npm run smoke, gateway:test, loadtest) have a moving market at any hour.
PRACTICE_MARKET_HOURS=always
# Symbols that always stream and seed the watchlist.
DEFAULT_SYMBOLS=AAPL,MSFT,NVDA,TSLA,AMZN,GOOGL,META,AMD,SPY,QQQ

# --- Trading rules ---------------------------------------------------------
# Dollars per share added to market buys and taken off market sells.
SLIPPAGE_PER_SHARE=0.01
# Market orders are refused when the newest quote is older than this (0 = off).
# This is what blocks market orders while the real market is closed.
MAX_QUOTE_AGE_SEC=120
MAX_ORDER_QUANTITY=100000

# --- Leaderboard worker ----------------------------------------------------
LEADERBOARD_INTERVAL_MS=10000
LEADERBOARD_SIZE=10

# --- Seed data (npm run db:seed) -------------------------------------------
# DEVELOPMENT-ONLY credentials. Change them before exposing this to anyone.
# The admin logs in with SEED_ADMIN_ID; demo traders are TRADER01, TRADER02, ...
# and all share SEED_TRADER_PASSWORD.
SEED_ADMIN_ID=ADMIN
SEED_ADMIN_PASSWORD=arena-admin-dev
SEED_TRADER_PASSWORD=arena-trader-dev
SEED_TRADER_COUNT=10

# --- Frontend (read by Next.js at build time) -------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000/ws

# Bot gateway. The WebSocket (/gateway) and REST (/api/gateway/v1) gateways are always on.
# These two switch on the low-latency binary protocol; leave them unset to keep it off.
GATEWAY_TCP_PORT=4010
GATEWAY_TCP_HOST=127.0.0.1
GATEWAY_UNIX_SOCKET=/tmp/gomer-gateway.sock
